---
interface Props {
	date?: Date;
}

const { date } = Astro.props;
---

{
	date instanceof Date && !isNaN(date.valueOf()) ? (
		<time datetime={date.toISOString()}>
			{
				date.toLocaleDateString('es-CL', {
					year: 'numeric',
					month: 'short',
					day: 'numeric',
				})
			}
		</time>
	) : (
		<span>Sin fecha</span>
	)
}
