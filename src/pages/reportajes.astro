---
const categories = [
  {
    title: 'Innovación y Tecnología Sustentable',
    href: 'https://tiempossustentables.cl/category/innovacion-y-tecnologia-sustentable/',
    description: 'Tecnología, innovación y soluciones habilitadoras de la transición sostenible.',
  },
  {
    title: 'Medioambiente y Cambio Climático',
    href: 'https://tiempossustentables.cl/category/medioambiente-y-cambio-climatico/',
    description: 'Clima, biodiversidad, transición energética y gestión ambiental.',
  },
  {
    title: 'Negocios y Finanzas Sostenibles',
    href: 'https://tiempossustentables.cl/category/negocios-y-finanzas-sostenibles/',
    description: 'ESG, inversión sostenible, reportes y creación de valor corporativo.',
  },
  {
    title: 'Estilo de Vida Sustentable',
    href: 'https://tiempossustentables.cl/category/estilo-de-vida-sustentable/',
    description: 'Consumo responsable, ciudades, movilidad y vida sostenible.',
  },
];
---

<main class="ts-page">
<section class="ts-intro">
  <span class="ts-badge">Periodismo en Profundidad</span>
  <h1>Reportajes y An&aacute;lisis ESG</h1>
  <p class="ts-lead">
    Investigaciones detalladas y periodismo de datos sobre las tendencias que marcan la pauta en
    sostenibilidad, criterios ESG y transformaci&oacute;n corporativa.
  </p>
  <p class="ts-muted">
    Explora nuestros reportajes, tanto propios como los aportes de nuestros colaboradores expertos,
    categorizados para encontrar la informaci&oacute;n t&eacute;cnica y estrat&eacute;gica que necesitas.
  </p>
</section>

  <section class="ts-categories">
    {categories.map((category) => (
      <article class="ts-category-card">
        <h2>{category.title}</h2>
        <p>{category.description}</p>
        <a href={category.href} target="_blank" rel="noopener noreferrer">
          Ver reportajes <span aria-hidden="true">→</span>
        </a>
      </article>
    ))}
  </section>

  <section class="ts-banner">
    <div class="ts-banner-inner">
      <div class="ts-banner-icon" aria-hidden="true">📊</div>
      <h2>Conoce nuestro nuevo Centro de Recursos y Transparencia</h2>
      <p>
        Explora nuestro panel de datos interactivos, documentos oficiales de compliance, repositorio
        de informes y archivo de publicaciones y columnas de expertos.
      </p>
      <a href="/centro-de-recursos" class="ts-banner-btn">Explorar el Centro de Recursos</a>
    </div>
  </section>
</main>

<style>
  .ts-page {
    max-width: 1180px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  .ts-intro {
    max-width: 800px;
    margin: 0 auto 48px;
    text-align: center;
  }

  .ts-badge {
    display: inline-block;
    background: #e0f2fe;
    color: #0a4a70;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 6px 16px;
    border-radius: 20px;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  h1 {
    color: #0a4a70;
    font-size: clamp(2rem, 5vw, 2.5rem);
    font-weight: 800;
    line-height: 1.2;
    margin: 0 0 24px;
  }

  .ts-lead {
    color: #475569;
    font-size: 1.15rem;
    line-height: 1.6;
    margin-bottom: 24px;
  }

  .ts-muted {
    color: #64748b;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .ts-categories {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin-bottom: 48px;
  }

  .ts-category-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 24px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
  }

  .ts-category-card h2 {
    color: #0a4a70;
    font-size: 1.25rem;
    margin: 0 0 8px;
  }

  .ts-category-card p {
    color: #64748b;
    font-size: 0.92rem;
    line-height: 1.55;
    margin: 0 0 16px;
  }

  .ts-category-card a {
    color: #e07b39;
    font-weight: 700;
    text-decoration: none;
  }

  .ts-banner {
    margin: 48px 0;
  }

  .ts-banner-inner {
    background: linear-gradient(135deg, #0a4a70, #05263b);
    border-radius: 16px;
    padding: clamp(2.5rem, 6vw, 4rem) clamp(1.5rem, 4vw, 2.5rem);
    text-align: center;
    color: #ffffff;
    box-shadow: 0 15px 35px rgba(10, 74, 112, 0.2);
  }

  .ts-banner-icon {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    margin-bottom: 20px;
  }

  .ts-banner h2 {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 800;
    margin: 0 0 20px;
  }

  .ts-banner p {
    color: #e2e8f0;
    max-width: 850px;
    margin: 0 auto 36px;
    line-height: 1.6;
  }

  .ts-banner-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #e07b39;
    color: #ffffff;
    font-weight: 700;
    padding: 14px 30px;
    border-radius: 8px;
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .ts-categories {
      grid-template-columns: 1fr;
    }
  }
</style>
