      <script is:inline>
        function tsToggleHomeVideo() {
          const wrapper = document.getElementById('ts-home-video-wrapper');
          const iframe = document.getElementById('ts-youtube-embed');
          if (!wrapper || !iframe) return;
          if (wrapper.style.display === 'block') { wrapper.style.display = 'none'; iframe.src = ''; }
          else { wrapper.style.display = 'block'; iframe.src = iframe.dataset.src; }
        }
        function procesarFormularioTS(e, form) {
          e.preventDefault();
          const nombre = document.getElementById('ts-nombre')?.value.trim() || 'amigo/a';
          document.getElementById('ts-form-content')?.classList.add('ts-form-blurred');
          document.getElementById('ts-success-message').innerHTML = '¡Gracias <strong>' + nombre + '</strong> por unirte a nuestra comunidad!';
          document.getElementById('ts-form-overlay').style.display = 'flex';
          localStorage.setItem('ts_comunidad_suscrito', new Date().toISOString());
          const action = form.getAttribute('action');
          if (action) fetch(action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
          return false;
        }
      </script>
